generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  phone     String?
  avatar    String?
  role      String   @default("vendor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups  SaleGroup[]
  orders  Order[]
  products      Product[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String
  color       String
  createdAt   DateTime @default(now())

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String   // On le garde pour la miniature principale
  images      String   @default("[]")
  sizes       String   @default("[]")
  colors      String   @default("[]")
  stock       Int      @default(100)
  featured    Boolean  @default(false)
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  orders   Order[]

  // NOUVEAU : Liaison optionnelle au groupe pour les catalogues exclusifs
  groupId  String?
  group    SaleGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // NOUVEAU : Liaison vers la table des médias (Vidéos et Images)
  media    ProductMedia[]

  vendorId    String
  vendor      User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

// NOUVEAU MODÈLE : Pour stocker les images et vidéos uploadées
model ProductMedia {
  id        String   @id @default(cuid())
  url       String   // L'URL du fichier uploadé (ex: Cloudinary)
  type      String   @default("IMAGE") // Peut être "IMAGE" ou "VIDEO"
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SaleGroup {
  id           String   @id @default(cuid())
  title        String
  description  String?
  coverImage   String?  // On va insérer l'URL de l'image uploadée ici
  minMembers   Int      @default(5)
  maxMembers   Int      @default(50)
  currentCount Int      @default(0)
  discount     Float    @default(0)
  deadline     DateTime
  status       String   @default("open")
  vendorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor User    @relation(fields: [vendorId], references: [id])
  orders Order[]
  
  // NOUVEAU : Le groupe possède maintenant son propre catalogue de produits
  products Product[]
}

model Order {
  id         String   @id @default(cuid())
  quantity   Int      @default(1)
  size       String?
  color      String?
  status     String   @default("pending")
  buyerName  String
  buyerPhone String
  buyerEmail String?
  notes      String?
  productId  String
  groupId    String
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product   @relation(fields: [productId], references: [id])
  group   SaleGroup @relation(fields: [groupId], references: [id])
  user    User?     @relation(fields: [userId], references: [id])
}